# 本项目有两个环境，各自读取自己目录下的 .env：
#   测试服：tech-blog/.env            （npm start，默认 http://localhost:3100）
#   正式服：tech-blog/.env.prod       （npm run release 后复制到 releases/prod/.env）
# 两个 .env 都不要提交到 git。
PORT=3100

# MySQL 连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
# 测试服用独立库，避免污染正式数据
DB_NAME=tech_blog_test
# 云数据库（如 TiDB Cloud）必须开启 TLS
DB_SSL=false

# 会话有效期（天）
SESSION_DAYS=30

# 站长发码口令：keygen.html 生成开通码时必须填写，务必改成随机长串
ADMIN_TOKEN=
