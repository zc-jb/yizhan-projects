{
  "name": "点餐系统",
  "appid": "",
  "description": "uni-app / Taro 点餐系统：菜单 / 购物车 / 下单 / 厨房实时看板 / 后台管理",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "vueVersion": "3",
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true,
      "showShadowRootInWxmlPanel": true
    },
    "usingComponents": true,
    "optimization": {
      "subPackages": true
    }
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "mp-baidu": {
    "usingComponents": true
  },
  "mp-toutiao": {
    "usingComponents": true
  },
  "h5": {
    "title": "点餐系统",
    "router": {
      "mode": "hash",
      "base": "./"
    },
    "devServer": {
      "port": 8200,
      "proxy": {
        "/api": {
          "target": "http://127.0.0.1:8200",
          "changeOrigin": true
        },
        "/ws": {
          "target": "ws://127.0.0.1:8200",
          "changeOrigin": true,
          "ws": true
        }
      }
    },
    "optimization": {
      "treeShaking": {
        "enable": true
      }
    }
  }
}
